{
    "name": "anodyne/blade-tabler-icons",
    "description": "A package to easily make use of Tabler icons in your Laravel Blade views.",
    "keywords": [
        "Blade",
        "Tabler",
        "Laravel"
    ],
    "homepage": "https://github.com/anodyne/blade-tabler-icons",
    "license": "MIT",
    "authors": [
        {
            "name": "Ryan Chandler",
            "email": "support@ryangjchandler.co.uk",
            "homepage": "https://ryangjchandler.co.uk",
            "role": "Developer"
        },
        {
            "name": "David VanScott",
            "email": "contact@anodyne-productions.com",
            "homepage": "https://anodyne-productions.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "blade-ui-kit/blade-icons": "^1.5",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "ext-dom": "*",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^1.23|^2.0|^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Anodyne\\TablerIcons\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Anodyne\\TablerIcons\\BladeTablerIconsServiceProvider"
            ]
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "update-icons": [
            "bun update @tabler/icons",
            "bun run build"
        ],
        "test": "vendor/bin/pest --colors=always"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
